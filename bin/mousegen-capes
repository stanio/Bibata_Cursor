#!/bin/sh
VERSION=${VERSION:-2.0.7-test}

cd "$(dirname "$0")/.."

BUILD_DIR=themes/mousecape

RENDER_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
done
echo "Colors: $MOUSE_COLORS"
echo

mousegenRender() {
  [ -t 1 ] && richout=true
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=$richout \
      -Dmousegen.animRateGain=1.395 -Dmousegen.maxAnimSize=160 \
      -Dmousegen.colors.replaceNamed=true -Dmousegen.renderer.asyncEncoding=2,3 \
      -Dmousecape.author=ful1e5 -Dmousecape.capeVersion=$VERSION"
  bin/mousegen-render \
      --mousecape-theme --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3 --no-shadow-also \
      --thin-stroke --stroke-width=8:Hairline \
      --min-stroke-width=0.9 \
      -s 1.5,1.375:Medium,1.25:Large -r 32,64,160,320 "$@"
}

set -e

modernName='Modern-${color}-${size}-${outline}-${shadow}'
originalName='Original-${color}-${size}-${outline}-${shadow}'

leftHandedModern=
leftHandedOriginal=
if [ "$MOUSE_LEFTHAND" = "true" ]; then
  leftHandedModern="--source svg/modern-right --name \${shadow:NoShadow}/Bibata-Left-handed-$modernName"
  leftHandedOriginal="--source svg/original-right --name \${shadow:NoShadow}/Bibata-Left-handed-$originalName"
fi

mousegenRender --source svg/modern --name "\${shadow:NoShadow}/Bibata-$modernName" \
    --source svg/original --name "\${shadow:NoShadow}/Bibata-$originalName" \
    $leftHandedModern $leftHandedOriginal \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --mousecape-theme=mac-names-efill-modern.json \
    --source svg/modern --name "\${shadow:NoShadow}/Bibata-$modernName" \
    $leftHandedModern \
    --expand-fill=4 --update-existing "$@"
echo
mousegenRender --mousecape-theme=mac-names-efill-original.json \
    --source svg/original --name "\${shadow:NoShadow}/Bibata-$originalName" \
    $leftHandedOriginal \
    --expand-fill=4 --update-existing "$@"

echo
bin/mousegen validate cape "$BUILD_DIR" > /dev/null

echo "Compressing packages... "
cp configs/COPYING "$BUILD_DIR"
. bin/package-colors.sh
cd "$BUILD_DIR"
dos2unix --quiet COPYING *.cape
for color in $MOUSE_COLORS; do
  getPkgName $color
  if [ -z "$pkgName" ]; then continue; fi
  echo "Bibata-Mousecape-$pkgName-v$VERSION.zip"
  jar cMf ../Bibata-Mousecape-$pkgName-v$VERSION.zip             COPYING */Bibata-[MO]*-$dirName*.cape
  if [ "$MOUSE_LEFTHAND" = "true" ]; then
    echo "Bibata-Mousecape-Left-handed-$pkgName-v$VERSION.zip"
    jar cMf ../Bibata-Mousecape-Left-handed-$pkgName-v$VERSION.zip COPYING */Bibata-Left*-$dirName*.cape
  fi
done
echo done.
