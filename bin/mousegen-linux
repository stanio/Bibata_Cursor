#!/bin/sh
VERSION=2.0.7-stanio-13-dev

cd "$(dirname "$0")/.."

BUILD_DIR=themes/linux

RENDER_COLORS=
THEME_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
  THEME_COLORS="$THEME_COLORS --var color=$color"
done

mousegenRender() {
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=true \
      -Dmousegen.renderer.asyncEncoding=1 \
      -Dmousegen.animRateGain=1.34 -Dxcur.cropToContent=true"
  bin/mousegen-render \
      --linux-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3: --no-shadow-also=NoShadow \
      --thin-stroke --stroke-width=8:Hairline \
      --min-stroke-width=0.9 \
      -s=1.5/0.75 -r 24,30,36,42,48,54,60,72 "$@" # -r × 1, 1.25, 1.5, 1.75, 2, 2.25, 2.5, 3
      #-s=1.5/0.75 -r 24,32,36,48,54,64,72,96 "$@"
}

set -e

mousegenRender --source svg/modern --name Bibata-Modern \
    --source svg/original --name Bibata-Original \
    --source svg/modern-right --name Bibata-Left-handed-Modern \
    --source svg/original-right --name Bibata-Left-handed-Original \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --linux-cursors=x11-names-efill-modern.json \
    --source svg/modern --name Bibata-Modern \
    --source svg/modern-right --name Bibata-Left-handed-Modern \
    --expand-fill=4 "$@"
echo
mousegenRender --linux-cursors=x11-names-efill-original.json \
    --source svg/original --name Bibata-Original \
    --source svg/original-right --name Bibata-Left-handed-Original \
    --expand-fill=4 "$@"

# Create theme files and symlinks
echo
bin/mousegen linuxThemeFiles "$BUILD_DIR" --config configs \
	$THEME_COLORS --var version=$VERSION --var size= --var shadow=NoShadow --var shadow=
bin/mousegen x11Symlinks -c configs "$BUILD_DIR"

echo -n "Compressing packages... "
cp configs/COPYING "$BUILD_DIR"
cd "$BUILD_DIR"
dos2unix --quiet COPYING */*.theme
for color in $MOUSE_COLORS; do
  tar cJf ../Bibata-Linux-$color-v$VERSION.tar.xz             COPYING Bibata-[MO]*-$color*
  tar cJf ../Bibata-Linux-Left-handed-$color-v$VERSION.tar.xz COPYING Bibata-Left*-$color*
done
echo done.
