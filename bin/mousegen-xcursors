#!/bin/sh
VERSION=2.0.7-stanio-15-dev

cd "$(dirname "$0")/.."

BUILD_DIR=themes/xcursors

RENDER_COLORS=
THEME_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
  THEME_COLORS="$THEME_COLORS --var color=$color"
done
echo "Colors: $MOUSE_COLORS"
echo

mousegenRender() {
  [ -t 1 ] && richout=true
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=$richout \
      -Dmousegen.colors.replaceNamed=true -Dmousegen.renderer.asyncEncoding=2 \
      -Dmousegen.animRateGain=1.34 -Dxcur.cropToContent=true"
  bin/mousegen-render \
      --linux-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3: --no-shadow-also=NoShadow \
      --thin-stroke --stroke-width=8:Hairline \
      --min-stroke-width=0.9 \
      -s=1.375/0.75 -r 18,24,30,32,36,42,48,54,60,64,72 "$@"
}

set -e

modernName='Modern-${color}-${size}-${outline}-${shadow}'
originalName='Original-${color}-${size}-${outline}-${shadow}'

mousegenRender --source svg/modern --name "\${shadow:Shadow}/Bibata-$modernName" \
    --source svg/original --name "\${shadow:Shadow}/Bibata-$originalName" \
    --source svg/modern-right --name "\${shadow:Shadow}/Bibata-Left-handed-$modernName" \
    --source svg/original-right --name "\${shadow:Shadow}/Bibata-Left-handed-$originalName" \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --linux-cursors=x11-names-efill-modern.json \
    --source svg/modern --name "\${shadow:Shadow}/Bibata-$modernName" \
    --source svg/modern-right --name "\${shadow:Shadow}/Bibata-Left-handed-$modernName" \
    --expand-fill=4 "$@"
echo
mousegenRender --linux-cursors=x11-names-efill-original.json \
    --source svg/original --name "\${shadow:Shadow}/Bibata-$originalName" \
    --source svg/original-right --name "\${shadow:Shadow}/Bibata-Left-handed-$originalName" \
    --expand-fill=4 "$@"

# Create theme files and symlinks
echo
bin/mousegen linuxThemeFiles "$BUILD_DIR/NoShadow" --config configs \
	$THEME_COLORS --var version=$VERSION --var size= --var shadow=NoShadow
bin/mousegen linuxThemeFiles "$BUILD_DIR/Shadow" --config configs \
	$THEME_COLORS --var version=$VERSION --var size= --var shadow=

echo -n "Creating alias symlinks "
bin/mousegen x11Symlinks -c configs "$BUILD_DIR"
echo ✔

echo
echo "Converting cursors_scalable to hyprcursors:"
bin/mousegen-hyprland

echo
echo "Compressing packages... "
cp configs/COPYING "$BUILD_DIR"
. bin/package-colors.sh
cd "$BUILD_DIR"
dos2unix --quiet COPYING */*/*.theme
for color in $MOUSE_COLORS; do
  getPkgName $color
  if [ -z "$pkgName" ]; then continue; fi
  echo "Bibata-Xcursors-$pkgName-v$VERSION.tar.xz"
  tar cJf ../Bibata-Xcursors-$pkgName-v$VERSION.tar.xz             COPYING */Bibata-[MO]*-$dirName*
  tar cJf ../Bibata-Xcursors-Left-handed-$pkgName-v$VERSION.tar.xz COPYING */Bibata-Left*-$dirName*  
done
echo done.
