#!/bin/sh
VERSION=2.0.7-stanio-15-dev

cd "$(dirname "$0")/.."

BUILD_DIR=themes/windows/

RENDER_COLORS=
THEME_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
  THEME_COLORS="$THEME_COLORS --var color=$color"
done

mousegenRender() {
  # -Dwincur.PNGEncoder=zopfli
  [ -t 1 ] && richout=true
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=$richout \
      -Dmousegen.renderer.asyncEncoding=2 \
      -Dmousegen.animRateGain=1.395 -Dmousegen.maxAnimSize=96"
  bin/mousegen-render \
      --windows-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3 --no-shadow-also \
      --thin-stroke --stroke-width=8:Hairline \
      --min-stroke-width=0.9 \
      -s N,1.375:Medium,L -r 32,48,64,72,96,128 "$@"
}

set -e

modernName='Modern-${color}-${size}-${outline}-${shadow}'
originalName='Original-${color}-${size}-${outline}-${shadow}'

mousegenRender --source svg/modern --name "\${shadow:NoShadow}/$modernName" \
    --source svg/original --name "\${shadow:NoShadow}/$originalName" \
    --source svg/modern-right --name "\${shadow:NoShadow}/Left-handed-$modernName" \
    --source svg/original-right --name "\${shadow:NoShadow}/Left-handed-$originalName" \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --windows-cursors=win-names-efill-modern.json \
    --source svg/modern --name "\${shadow:NoShadow}/$modernName" \
    --source svg/modern-right --name "\${shadow:NoShadow}/Left-handed-$modernName" \	
    --expand-fill=4 "$@"
echo
mousegenRender --windows-cursors=win-names-efill-original.json \
    --source svg/original --name "\${shadow:NoShadow}/$originalName" \
    --source svg/original-right --name "\${shadow:NoShadow}/Left-handed-$originalName" \
    --expand-fill=4 "$@"

# Create install scripts
echo
bin/mousegen windowsInstallScripts "$BUILD_DIR/NoShadow" --config configs \
	$THEME_COLORS --var version=$VERSION
bin/mousegen windowsInstallScripts "$BUILD_DIR/Shadow" --config configs \
	$THEME_COLORS --var version=$VERSION --var shadow=Shadow

echo -n "Compressing packages... "
cp configs/COPYING "$BUILD_DIR"
cd "$BUILD_DIR"
unix2dos --quiet COPYING */*.inf
set +e # Classic/Classic-GE and Ice/Ice-GE get groupped in the same *.inf
for color in $MOUSE_COLORS; do
  jar cMf ../Bibata-Windows-$color-v$VERSION.zip             COPYING */[MO]*-$color* */install-Bibata-$color*.inf
  jar cMf ../Bibata-Windows-Left-handed-$color-v$VERSION.zip COPYING */Left*-$color* */install-Bibata-Left*-$color*.inf
done
echo done.
