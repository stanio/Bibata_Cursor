#!/bin/sh
VERSION=${VERSION:-2.0.7-test}

cd "$(dirname "$0")/.."

BUILD_DIR=themes/windows/

RENDER_COLORS=
THEME_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
  THEME_COLORS="$THEME_COLORS --var color=$color"
done
echo "Colors: $MOUSE_COLORS"
echo

mousegenRender() {
  # -Dwincur.PNGEncoder=zopfli
  [ -t 1 ] && richout=true
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=$richout \
      -Dmousegen.colors.replaceNamed=true -Dmousegen.renderer.asyncEncoding=2 \
      -Dmousegen.animRateGain=1.395 -Dmousegen.maxAnimSize=96"
  bin/mousegen-render \
      --windows-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3 --no-shadow-also \
      --thin-stroke --stroke-width=8:Hairline \
      --min-stroke-width=0.9 \
      -s N,1.375:Medium,L -r 32,48,64,72,96,128 "$@"
}

set -e

modernName='Modern-${color}-${size}-${outline}-${shadow}'
originalName='Original-${color}-${size}-${outline}-${shadow}'

leftHandedModern=
leftHandedOriginal=
if [ "$MOUSE_LEFTHAND" = "true" ]; then
  leftHandedModern="--source svg/modern-right --name \${shadow:NoShadow}/Left-handed-$modernName"
  leftHandedOriginal="--source svg/original-right --name \${shadow:NoShadow}/Left-handed-$originalName"
fi

mousegenRender --source svg/modern --name "\${shadow:NoShadow}/$modernName" \
    --source svg/original --name "\${shadow:NoShadow}/$originalName" \
    $leftHandedModern $leftHandedOriginal \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --windows-cursors=win-names-efill-modern.json \
    --source svg/modern --name "\${shadow:NoShadow}/$modernName" \
    $leftHandedModern \
    --expand-fill=4 "$@"
echo
mousegenRender --windows-cursors=win-names-efill-original.json \
    --source svg/original --name "\${shadow:NoShadow}/$originalName" \
    $leftHandedOriginal \
    --expand-fill=4 "$@"

# Create install scripts
echo
leftHanded="--var right=" # Exclude
if [ "$MOUSE_LEFTHAND" = "true" ]; then
  leftHanded= # Default, include
fi
bin/mousegen windowsInstallScripts "$BUILD_DIR/NoShadow" --config configs \
	$THEME_COLORS --var version=$VERSION $leftHanded
bin/mousegen windowsInstallScripts "$BUILD_DIR/Shadow" --config configs \
	$THEME_COLORS --var version=$VERSION --var shadow=Shadow $leftHanded

bin/mousegen validate wincur "$BUILD_DIR" > /dev/null

echo "Compressing packages... "
cp configs/COPYING "$BUILD_DIR"
. bin/package-colors.sh
cd "$BUILD_DIR"
unix2dos --quiet COPYING */*.inf
for color in $MOUSE_COLORS; do
  getPkgName $color
  if [ -z "$pkgName" ]; then continue; fi
  echo "Bibata-Windows-$pkgName-v$VERSION.zip"
  jar cMf ../Bibata-Windows-$pkgName-v$VERSION.zip             COPYING */[MO]*-$dirName* */install-Bibata-$dirName*.inf
  if [ "$MOUSE_LEFTHAND" = "true" ]; then
    echo "Bibata-Windows-Left-handed-$pkgName-v$VERSION.zip"
    jar cMf ../Bibata-Windows-Left-handed-$pkgName-v$VERSION.zip COPYING */Left*-$dirName* */install-Bibata-Left*-$dirName*.inf
  fi
done
echo done.
