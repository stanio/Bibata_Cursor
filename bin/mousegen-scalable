#!/bin/sh
VERSION=2.0.7-stanio-12-dev

cd "$(dirname "$0")/.."

BUILD_DIR=themes/linux

RENDER_COLORS=
THEME_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
  THEME_COLORS="$THEME_COLORS --var color=$color"
done

mousegenRender() {
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=true \
      -Dmousegen.animRateGain=1.34 -Dmousegen.balanceCanvasSize=true \
      -Dmousegen.canvasBalanceFactor=1 -Dmousegen.canvasBalanceLimit=0.5"
  bin/mousegen-render \
      --scalable-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3: --no-shadow-also=NoShadow \
      --thin-stroke --stroke-width=8:Hairline \
      -s=1.5/0.75 -r 24 "$@"
      #-s=1.25/0.75 -r 24 "$@"
}

set -e

mousegenRender --source svg/modern --name Bibata-Modern \
    --source svg/original --name Bibata-Original \
    --source svg/modern-right --name Bibata-Left-handed-Modern \
    --source svg/original-right --name Bibata-Left-handed-Original \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --scalable-cursors=x11-names-efill-modern.json \
    --source svg/modern --name Bibata-Modern \
    --source svg/modern-right --name Bibata-Left-handed-Modern \
    --expand-fill=4 "$@"
echo
mousegenRender --scalable-cursors=x11-names-efill-original.json \
    --source svg/original --name Bibata-Original \
    --source svg/original-right --name Bibata-Left-handed-Original \
    --expand-fill=4 "$@"

#echo
#echo dos2unix
#find "$BUILD_DIR" -type f -name '*.svg' -exec dos2unix -q "{}" +

echo
echo 'Run `bin/mousegen-linux` to complete the packages.'
