#!/bin/sh
#VERSION=2.0.7-stanio-13-dev

cd "$(dirname "$0")/.."

BUILD_DIR=themes/linux

RENDER_COLORS=
[ -z "$MOUSE_COLORS" ] && MOUSE_COLORS="Classic Ice"
for color in $MOUSE_COLORS; do
  RENDER_COLORS="$RENDER_COLORS --color $color"
done

mousegenRender() {
  export MOUSEGEN_OPTS="$MOUSEGEN_OPTS -Dmousegen.dynamicOutput=true \
      -Dmousegen.animRateGain=1.34 -Dmousegen.enableSizingOrigin=true \
      -Dmousegen.defaultAnchor=0.5 -Dmousegen.defaultScalableGrid=4 \
      -Dmousegen.altAlignAnchor=align-anchor-scalable"
  bin/mousegen-render \
      --scalable-cursors --build-dir "$BUILD_DIR" \
      $RENDER_COLORS \
      --pointer-shadow=9,15,9,0.3: --no-shadow-also=NoShadow \
      --thin-stroke --stroke-width=8:Hairline \
      -s=1.5/0.75 -r 24 "$@"
}

set -e

modernName='Modern-${color}-${size}-${outline}-${shadow}'
originalName='Original-${color}-${size}-${outline}-${shadow}'

mousegenRender --source svg/modern --name "\${shadow:Shadow}/Bibata-$modernName" \
    --source svg/original --name "\${shadow:Shadow}/Bibata-$originalName" \
    --source svg/modern-right --name "\${shadow:Shadow}/Bibata-Left-handed-$modernName" \
    --source svg/original-right --name "\${shadow:Shadow}/Bibata-Left-handed-$originalName" \
    --all-variants "$@"

echo
echo "=== Thinner strokes with expanded fill"
echo
mousegenRender --scalable-cursors=x11-names-efill-modern.json \
    --source svg/modern --name "\${shadow:Shadow}/Bibata-$modernName" \
    --source svg/modern-right --name "\${shadow:Shadow}/Bibata-Left-handed-$modernName" \
    --expand-fill=4 "$@"
echo
mousegenRender --scalable-cursors=x11-names-efill-original.json \
    --source svg/original --name "\${shadow:Shadow}/Bibata-$originalName" \
    --source svg/original-right --name "\${shadow:Shadow}/Bibata-Left-handed-$originalName" \
    --expand-fill=4 "$@"

#echo
#echo dos2unix
#find "$BUILD_DIR" -type f -name '*.svg' -name 'metadata.json' -exec dos2unix -q "{}" +

echo
echo 'Run `bin/mousegen-linux` to complete the packages.'
