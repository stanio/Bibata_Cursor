#!/bin/sh
cd "$(dirname "$0")/.."

# Download 'mousegen' if it doesn't exist or is outdated
MTAG="0.9"
MTIME=1760183636 # 2025-10-11 11:53:56
if [ ! -f "bin/mousegen" ] || [ $(stat -c "%Y" "bin/mousegen") -lt $MTIME ]; then
  curl --progress-bar --fail -LRo bin/mousegen \
      "https://github.com/stanio/stanio-misc/releases/download/mousegen-$MTAG/mousegen.sh"
  chmod u+x bin/mousegen
fi

[ -z "$MOUSEGEN_OPTS" ] && export \
    MOUSEGEN_OPTS="-Dmousegen.dynamicOutput=true -Dmousegen.animRateGain=1.395"

# Prevent arguments being automatically replaced
# by MSYS2: "/1.25" -> "C:/Program Files/git/1.25"
# https://www.msys2.org/docs/filesystem-paths/
#export MSYS2_ARG_CONV_EXCL="*"
export MSYS2_ARG_CONV_EXCL="-s"
# https://github.com/git-for-windows/msys2-runtime/pull/11#issuecomment-112817152
#export MSYS_NO_PATHCONV=1
bin/mousegen render --config configs "$@"
